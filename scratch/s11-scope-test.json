{
  "src": {
    "image": "farosai/airbyte-github-source:0.23.48",
    "config": {
      "authentication": {
        "type": "token",
        "personal_access_token": "REPLACED_AT_RUNTIME"
      },
      "organizations": ["InfraLore"],
      "repositories": ["InfraLore/make_for_devops"],
      "cutoff_days": 30,
      "run_mode": "Custom",
      "custom_streams": [
        "faros_organizations",
        "faros_repositories",
        "faros_users",
        "faros_commits",
        "faros_pull_requests",
        "faros_pull_request_comments",
        "faros_tags",
        "faros_releases",
        "faros_workflows",
        "faros_workflow_runs",
        "faros_workflow_jobs",
        "faros_issues",
        "faros_issue_comments",
        "faros_labels"
      ],
      "skip_reset_models": [
        "cicd_Release",
        "cicd_ReleaseTagAssociation",
        "vcs_Tag",
        "vcs_RepositoryTag",
        "cicd_Pipeline"
      ]
    }
  },
  "dst": {
    "image": "farosai/airbyte-faros-destination:0.22.37",
    "config": {
      "edition_configs": {
        "edition": "community",
        "hasura_url": "http://host.docker.internal:8080"
      }
    }
  }
}
